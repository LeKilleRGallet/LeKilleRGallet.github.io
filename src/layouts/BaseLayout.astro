---
import "../styles/global.css";
import { publicProfile } from "../data/publicProfile";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: "es" | "en";
  alternateEs?: string;
  alternateEn?: string;
}

const {
  title = publicProfile.name,
  description = publicProfile.description,
  image = "/favicon.svg",
  lang = "es",
  alternateEs,
  alternateEn,
} = Astro.props;

const isEnglish = lang === "en";
const fullTitle = title === publicProfile.name ? title : `${title} | ${publicProfile.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const personId = new URL("/#person", Astro.site).toString();
const websiteId = new URL("/#website", Astro.site).toString();

const graphJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: publicProfile.links.website,
      name: "Augusto Rico — Economics, Data & Research",
      description: publicProfile.descriptionEn,
      inLanguage: ["es", "en"],
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: publicProfile.name,
      url: publicProfile.links.website,
      mainEntityOfPage: publicProfile.links.about,
      jobTitle: "Economist and Data Analyst",
      description: publicProfile.descriptionEn,
      email: `mailto:${publicProfile.email}`,
      homeLocation: {
        "@type": "Place",
        name: `${publicProfile.location.city}, ${publicProfile.location.country}`,
      },
      alumniOf: publicProfile.education.map((education) => ({
        "@type": "CollegeOrUniversity",
        name: education.institution,
      })),
      worksFor: {
        "@type": "Organization",
        name: "DIAN — Dirección de Impuestos y Aduanas Nacionales",
      },
      knowsAbout: [...publicProfile.skills, ...publicProfile.researchAreas],
      knowsLanguage: publicProfile.languages.map((x) => x.language),
      sameAs: [publicProfile.links.github, publicProfile.links.linkedin],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={publicProfile.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111827" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />

    <link rel="canonical" href={canonical} />
    <link rel="author" href="/sobre-mi/" />
    {alternateEs && <link rel="alternate" hreflang="es" href={new URL(alternateEs, Astro.site)} />}
    {alternateEn && <link rel="alternate" hreflang="en" href={new URL(alternateEn, Astro.site)} />}
    {(alternateEs || alternateEn) && <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Augusto Rico — Research & Portfolio"
      href="/feed.xml"
    />
    <link rel="alternate" type="application/json" href="/api/profile.json" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Augusto Rico" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={isEnglish ? "en_US" : "es_CO"} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(graphJsonLd)} />
    <slot name="head" />

    <title>{fullTitle}</title>
  </head>

  <body>
    <a class="skip-link" href="#contenido">{isEnglish ? "Skip to content" : "Ir al contenido"}</a>

    <header class="site-header">
      <div class="container navigation">
        <a class="brand" href={isEnglish ? "/en/" : "/"} aria-label={isEnglish ? "Augusto Rico, home" : "Augusto Rico, inicio"}>
          <span class="brand-mark">AR</span>
          <span>Augusto Rico</span>
        </a>

        <nav aria-label={isEnglish ? "Main navigation" : "Navegación principal"}>
          {isEnglish ? (
            <>
              <a href="/en/about/">About</a>
              <a href="/en/research/">Research</a>
              <a href="/en/topics/">Topics</a>
              <a href="/en/archive/">Archive</a>
              <a href="/en/data/">Data</a>
              <a href="/en/finance/">Finance</a>
              <a href="/en/collaborate/">Collaborate</a>
              <a href="/en/cv/">CV</a>
              <a href="/">Español</a>
            </>
          ) : (
            <>
              <a href="/investigacion/">Investigación</a>
              <a href="/temas/">Temas</a>
              <a href="/archivo/">Archivo</a>
              <a href="/agenda/">Agenda</a>
              <a href="/colaborar/">Colaborar</a>
              <a href="/cv/">CV</a>
              <a href="/sobre-mi/">Sobre mí</a>
              <a href="/en/">English</a>
            </>
          )}
        </nav>
      </div>
    </header>

    <main id="contenido" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>{publicProfile.name}</strong>
          <p>{isEnglish ? "Economics, data and research." : "Economía, datos e investigación."}</p>
        </div>

        <div class="footer-links">
          <a href={`mailto:${publicProfile.email}`}>Email</a>
          <a href={publicProfile.links.linkedin} target="_blank" rel="me noreferrer">LinkedIn</a>
          <a href={publicProfile.links.github} target="_blank" rel="me noreferrer">GitHub</a>
          <a href="/llms.txt">llms.txt</a>
        </div>
      </div>
    </footer>
  </body>
</html>
