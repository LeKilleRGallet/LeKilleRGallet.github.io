---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Augusto Rico",
  description = "Portafolio acadmico de investigacin.",
} = Astro.props;

const fullTitle =
  title === "Augusto Rico"
    ? title
    : `${title} | Augusto Rico`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container navigation">
        <a class="brand" href="/">Augusto Rico</a>

        <nav aria-label="Navegacin principal">
          <a href="/investigacion/">Investigacin</a>
          <a href="/sobre-mi/">Sobre m</a>
          <a href="/cv/">CV</a>
          <a href="/contacto/">Contacto</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
         {new Date().getFullYear()} Augusto Rico
      </div>
    </footer>
  </body>
</html>
