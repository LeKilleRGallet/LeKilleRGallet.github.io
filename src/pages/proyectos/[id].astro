---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const proyectos = await getCollection("proyectos", ({ data }) => data.public);

  return proyectos.map((proyecto) => ({
    params: { id: proyecto.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);

const {
  title,
  subtitle,
  type,
  status,
  year,
  authors,
  role,
  summary,
  topics,
  pdf,
  repository,
  updated,
} = proyecto.data;
---

<BaseLayout title={title} description={summary}>
  <article class="prose wide">
    <a class="back-link" href="/investigacion/">← Investigación</a>

    <header class="project-header">
      <div class="status-row">
        <span class="status">{status}</span>
        <span>{type}</span>
        <span>{year}</span>
      </div>

      <h1>{title}</h1>
      {subtitle && <p class="project-subtitle">{subtitle}</p>}

      <p class="metadata">{authors.join(", ")}{role ? ` · ${role}` : ""}</p>

      <div class="actions">
        {pdf && <a class="button primary" href={pdf} target="_blank" rel="noreferrer">Ver PDF</a>}
        {repository && <a class="button" href={repository} target="_blank" rel="noreferrer">Código / repositorio</a>}
      </div>
    </header>

    <div class="project-summary">
      <h2>Resumen</h2>
      <p>{summary}</p>
    </div>

    <Content />

    <h2>Temas</h2>
    <ul class="tags">
      {topics.map((topic) => <li>{topic}</li>)}
    </ul>

    <p class="muted">
      Actualizado: {updated.toLocaleDateString("es-CO", { timeZone: "UTC" })}
    </p>
  </article>
</BaseLayout>
