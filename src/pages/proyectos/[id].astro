---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { topicHubs } from "../../data/topics";

export async function getStaticPaths() {
  const proyectos = await getCollection("proyectos", ({ data }) => data.public);

  return proyectos.map((proyecto) => ({
    params: { id: proyecto.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const relatedTopicHubs = topicHubs.filter((hub) =>
  (hub.projectIds as readonly string[]).includes(proyecto.id)
);

const {
  title,
  subtitle,
  type,
  status,
  year,
  authors,
  contributors,
  role,
  summary,
  topics,
  pdf,
  repository,
  citekey,
  citationType = "unpublished",
  updated,
} = proyecto.data;

const canonical = new URL(`/proyectos/${proyecto.id}/`, Astro.site).toString();
const pdfUrl = pdf ? new URL(pdf, Astro.site).toString() : undefined;
const personId = new URL("/#person", Astro.site).toString();
const websiteId = new URL("/#website", Astro.site).toString();

const personRef = (name: string) =>
  name === "Augusto Rico"
    ? { "@type": "Person", "@id": personId, name }
    : { "@type": "Person", name };

const citationText = `${authors.join(", ")} (${year}). ${title}. ${status}. ${canonical}`;
const bibtex = citekey
  ? `@${citationType}{${citekey},
  author = {${authors.join(" and ")}},
  title = {${title}},
  year = {${year}},
  note = {${status}},
  url = {${canonical}}${pdfUrl ? `,
  pdf = {${pdfUrl}}` : ""}
}`
  : undefined;

const schemaType = type.toLowerCase().includes("proyecto")
  ? "ResearchProject"
  : "ScholarlyArticle";

const creativeJsonLd =
  schemaType === "ResearchProject"
    ? {
        "@context": "https://schema.org",
        "@type": "ResearchProject",
        "@id": `${canonical}#research-project`,
        name: title,
        description: summary,
        startDate: `${year}-01-01`,
        dateModified: updated.toISOString().slice(0, 10),
        url: canonical,
        keywords: topics.join(", "),
        author: authors.map(personRef),
        contributor: contributors.map((item) => ({
          ...personRef(item.name),
          description: item.role,
        })),
        isPartOf: { "@id": websiteId },
      }
    : {
        "@context": "https://schema.org",
        "@type": "ScholarlyArticle",
        "@id": `${canonical}#work`,
        headline: title,
        name: title,
        description: summary,
        author: authors.map(personRef),
        contributor: contributors.map((item) => ({
          ...personRef(item.name),
          description: item.role,
        })),
        datePublished: String(year),
        dateModified: updated.toISOString().slice(0, 10),
        url: canonical,
        mainEntityOfPage: canonical,
        isPartOf: { "@id": websiteId },
        keywords: topics.join(", "),
        encoding: pdfUrl
          ? {
              "@type": "MediaObject",
              contentUrl: pdfUrl,
              encodingFormat: "application/pdf",
            }
          : undefined,
        creativeWorkStatus: status,
      };

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: new URL("/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Investigación",
      item: new URL("/investigacion/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: canonical,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={summary}
  alternateEs={`/proyectos/${proyecto.id}/`}
  alternateEn={`/en/projects/${proyecto.id}/`}
>
  <Fragment slot="head">
    {citekey && <meta name="citation_title" content={title} />}
    {citekey && authors.map((author) => <meta name="citation_author" content={author} />)}
    {citekey && <meta name="citation_publication_date" content={String(year)} />}
    {citekey && <meta name="citation_abstract_html_url" content={canonical} />}
    {citekey && <meta name="citation_fulltext_html_url" content={canonical} />}
    {citekey && pdfUrl && <meta name="citation_pdf_url" content={pdfUrl} />}
    {citekey && topics.map((topic) => <meta name="citation_keywords" content={topic} />)}
    {citekey && <link rel="alternate" type="application/x-bibtex" href={`/citations/${proyecto.id}.bib`} />}
    <script type="application/ld+json" set:html={JSON.stringify(creativeJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <article class="prose wide">
    <a class="back-link" href="/investigacion/">← Investigación</a>

    <header class="project-header">
      <div class="status-row">
        <span class="status">{status}</span>
        <span>{type}</span>
        <span>{year}</span>
      </div>

      <h1>{title}</h1>
      {subtitle && <p class="project-subtitle">{subtitle}</p>}

      <p class="metadata">
        Autoría: {authors.join(", ")}
        {role ? ` · Rol de Augusto Rico: ${role}` : ""}
      </p>

      {contributors.length > 0 && (
        <p class="metadata">
          {contributors.map((item) => `${item.name} — ${item.role}`).join(" · ")}
        </p>
      )}

      <div class="actions">
        {pdf && <a class="button primary" href={pdf} target="_blank" rel="noreferrer">Ver PDF</a>}
        {repository && <a class="button" href={repository} target="_blank" rel="noreferrer">Fuente en GitHub</a>}
        {citekey && <a class="button" href={`/citations/${proyecto.id}.bib`}>BibTeX</a>}
        <a class="button" href={`/en/projects/${proyecto.id}/`}>English</a>
      </div>
    </header>

    <div class="project-summary">
      <h2>Resumen</h2>
      <p>{summary}</p>
    </div>

    <Content />

    {citekey && (
      <section class="citation-box" aria-labelledby="como-citar">
        <p class="eyebrow">Citation</p>
        <h2 id="como-citar">Cómo citar</h2>
        <p>{citationText}</p>
        <pre><code>{bibtex}</code></pre>
        <p class="muted">
          Esta referencia identifica un working paper o manuscrito alojado en este sitio.
          No implica DOI, publicación en revista ni revisión por pares.
        </p>
      </section>
    )}

    {relatedTopicHubs.length > 0 && (
      <section class="section-block">
        <p class="eyebrow">Contexto temático</p>
        <h2>Explorar por área</h2>
        <div class="actions">
          {relatedTopicHubs.map((hub) => (
            <a class="button" href={`/temas/${hub.slug}/`}>{hub.title}</a>
          ))}
        </div>
      </section>
    )}

    <h2>Temas</h2>
    <ul class="tags">
      {topics.map((topic) => <li>{topic}</li>)}
    </ul>

    <p class="muted">
      Actualizado: {updated.toLocaleDateString("es-CO", { timeZone: "UTC" })}
    </p>
  </article>
</BaseLayout>
