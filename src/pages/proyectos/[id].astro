---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const proyectos = await getCollection(
    "proyectos",
    ({ data }) => data.public
  );

  return proyectos.map((proyecto) => ({
    params: { id: proyecto.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);

const {
  title,
  subtitle,
  type,
  status,
  year,
  authors,
  summary,
  topics,
  pdf,
  updated,
} = proyecto.data;
---

<BaseLayout title={title} description={summary}>
  <article class="prose">
    <a href="/investigacion/"> Investigacin</a>

    <p class="metadata">{type}  {status}  {year}</p>

    <h1>{title}</h1>
    {subtitle && <h2>{subtitle}</h2>}

    <p>{authors.join(", ")}</p>

    <div class="actions">
      {
        pdf && (
          <>
            <a
              class="button primary"
              href={pdf}
              target="_blank"
              rel="noreferrer"
            >
              Ver PDF
            </a>

            <a class="button" href={pdf} download>
              Descargar
            </a>
          </>
        )
      }
    </div>

    <h2>Resumen</h2>
    <p>{summary}</p>

    <h2>Contenido</h2>
    <Content />

    <h2>Temas</h2>
    <ul class="tags">
      {topics.map((topic) => <li>{topic}</li>)}
    </ul>

    <p class="muted">
      Actualizado: {
        updated.toLocaleDateString("es-CO", {
          timeZone: "UTC",
        })
      }
    </p>
  </article>
</BaseLayout>
