      </div>
      <div>
        <span>Académico</span>
        <a href="mailto:arico@unal.edu.co">arico@unal.edu.co</a>
      </div>
      <div>
        <span>LinkedIn</span>
        <a href="https://www.linkedin.com/in/lekillergallet/" target="_blank" rel="noreferrer">linkedin.com/in/lekillergallet</a>
