---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { publicProfile } from "../data/publicProfile";

const proyectos = (
  await getCollection("proyectos", ({ data }) => data.public && data.featured)
).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  title="Augusto Rico"
  description="Augusto Rico: economista de la Universidad Nacional de Colombia, Analista I en la DIAN, data analyst e investigador en Bogotá. Python, SQL, PySpark, Databricks, Power BI, econometría y machine learning."
  alternateEs="/"
  alternateEn="/en/"
>
  <section class="hero">
    <p class="eyebrow">{publicProfile.headline}</p>
    <h1>Economía, datos e investigación aplicada.</h1>
    <p class="hero-copy">
      {publicProfile.description}
      Desarrollo análisis cuantitativo, flujos reproducibles y proyectos de
      investigación con {publicProfile.skills.slice(0, 6).join(", ")}.
    </p>

    <div class="actions">
      <a class="button primary" href="/investigacion/">Ver investigación</a>
      <a class="button" href="/colaborar/">Colaborar</a>
      <a class="text-link" href="/pdf/cv.pdf" target="_blank" rel="noreferrer">CV en PDF</a>
    </div>

    <ul class="hero-facts" aria-label="Datos principales">
      <li>{publicProfile.location.city}, {publicProfile.location.country}</li>
      <li>{publicProfile.languages.map((x) => x.language).join(" · ")}</li>
      <li>{publicProfile.availability.slice(0, 3).join(" · ")}</li>
    </ul>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Trabajo actual</p>
        <h2>Analítica y evidencia para decisiones</h2>
      </div>
    </div>

    <div class="capability-grid">
      <article class="capability">
        <span class="number">01</span>
        <h3>Datos</h3>
        <p>Integración, limpieza, validación y automatización de bases administrativas con Python, SQL, PySpark y Databricks.</p>
      </article>
      <article class="capability">
        <span class="number">02</span>
        <h3>Modelación</h3>
        <p>Clasificación, segmentación, series de tiempo, evaluación de modelos y análisis estadístico.</p>
      </article>
      <article class="capability">
        <span class="number">03</span>
        <h3>Investigación</h3>
        <p>Economía conductual, teoría de juegos, finanzas cuantitativas, causalidad, redes y política pública.</p>
      </article>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Portfolio paths</p>
        <h2>Tres entradas según el problema.</h2>
      </div>
    </div>

    <div class="audience-grid">
      <article class="audience-card">
        <p class="eyebrow">Data</p>
        <h3>Data & BI</h3>
        <p>Python, SQL, PySpark, Databricks, automatización, data quality y Power BI.</p>
        <a class="text-link" href="/data/">Ver perfil de datos</a>
      </article>
      <article class="audience-card">
        <p class="eyebrow">Research</p>
        <h3>Research</h3>
        <p>Working papers, métodos cuantitativos, economía aplicada y soporte de investigación.</p>
        <a class="text-link" href="/research/">Ver perfil de investigación</a>
      </article>
      <article class="audience-card">
        <p class="eyebrow">Finance</p>
        <h3>Finance & Quant</h3>
        <p>Series de tiempo, volatilidad, econometría, forecasting y portafolios.</p>
        <a class="text-link" href="/finance/">Ver perfil financiero</a>
      </article>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research</p>
        <h2>Proyectos seleccionados</h2>
      </div>
      <a class="text-link" href="/investigacion/">Ver todos</a>
    </div>

    <div class="project-grid">
      {proyectos.map((proyecto) => <ProjectCard proyecto={proyecto} />)}
    </div>
  </section>

  <section class="section-block">
    <div class="two-column">
      <div>
        <p class="eyebrow">Public source of truth</p>
        <h2>Perfil público legible por personas y máquinas.</h2>
        <p>
          El sitio mantiene un perfil canónico, investigación con estados explícitos,
          PDFs, archivo académico y endpoints públicos para agentes y buscadores.
        </p>
      </div>
      <div>
        <p class="eyebrow">Machine-readable</p>
        <ul>
          <li><a href="/api/profile.json">Perfil JSON</a></li>
          <li><a href="/api/research.json">Investigación JSON</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/feed.xml">Feed</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="callout">
    <div>
      <p class="eyebrow">Colaboración</p>
      <h2>Data, research support y análisis económico.</h2>
      <p>
        Puedo apoyar proyectos por horas o por entregables en análisis de datos,
        BI, investigación cuantitativa, revisión de evidencia y evaluación de modelos.
      </p>
    </div>
    <a class="button primary" href="/colaborar/">Áreas de colaboración</a>
  </section>
</BaseLayout>
