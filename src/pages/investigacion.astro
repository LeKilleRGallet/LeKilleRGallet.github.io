---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const proyectos = (
  await getCollection("proyectos", ({ data }) => data.public)
).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  title="Investigación en economía y datos"
  description="Working papers, manuscritos y proyectos de Augusto Rico en economía, métodos cuantitativos, finanzas, comportamiento, datos y política pública."
  alternateEs="/investigacion/"
  alternateEn="/en/research/"
>
  <header class="page-header">
    <p class="eyebrow">Research portfolio</p>
    <h1>Investigación</h1>
    <p>
      Working papers, manuscritos y proyectos. El estado de cada trabajo se
      muestra de forma explícita; una ficha en este sitio no implica publicación
      ni revisión por pares.
    </p>
  </header>

  <div class="project-grid">
    {proyectos.map((proyecto) => <ProjectCard proyecto={proyecto} />)}
  </div>

  <section class="section-block">
    <div class="two-column">
      <div>
        <p class="eyebrow">Método</p>
        <h2>Estado explícito y evidencia reproducible.</h2>
        <p>
          Cada ficha separa autoría, rol, estado del trabajo, PDF y fuente cuando existen.
          Esto permite distinguir working papers, manuscritos y proyectos sin atribuirles
          un estatus editorial que no tienen.
        </p>
      </div>
      <div>
        <p class="eyebrow">Conexiones</p>
        <p>
          Los proyectos se conectan con hubs temáticos de econometría, economía
          conductual, finanzas cuantitativas, datos y cumplimiento tributario.
        </p>
        <a class="button" href="/temas/">Explorar por temas</a>
      </div>
    </div>
  </section>

  <section class="section-block compact">
    <div class="callout">
      <div>
        <p class="eyebrow">Research agenda</p>
        <h2>Ideas y líneas todavía abiertas.</h2>
        <p>La agenda separa preguntas de investigación de manuscritos que ya tienen desarrollo.</p>
      </div>
      <a class="button" href="/agenda/">Ver agenda</a>
    </div>
  </section>
</BaseLayout>
