---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archiveDocuments } from "../data/archive";
---

<BaseLayout
  title="Archivo académico"
  description="Archivo público de working papers, trabajos académicos, econometría, series de tiempo, economía y documentos de Augusto Rico."
>
  <header class="page-header">
    <p class="eyebrow">Academic archive</p>
    <h1>Documentos y evidencia de trabajo.</h1>
    <p>
      El archivo reúne PDFs ya existentes en mis repositorios. Los documentos de curso,
      trabajos académicos y ensayos se etiquetan como tales y no se presentan como
      publicaciones revisadas por pares.
    </p>
  </header>

  <div class="archive-list">
    {archiveDocuments.map((doc) => (
      <article class="archive-item">
        <div>
          <p class="metadata">{doc.type} · {doc.authors.join(", ")} · {doc.year}</p>
          <h2>{doc.title}</h2>
          <p>{doc.note}</p>
          <ul class="tags">
            {doc.topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </div>
        <a
          class="button"
          href={doc.href}
          target={doc.href.startsWith("http") ? "_blank" : undefined}
          rel={doc.href.startsWith("http") ? "noreferrer" : undefined}
        >
          Abrir
        </a>
      </article>
    ))}
  </div>

  <p class="tracking-note">
    Versión legible por máquinas: <a href="/api/archive.json">/api/archive.json</a>
  </p>
</BaseLayout>
