---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { publicProfile } from "../../data/publicProfile";

const projects = (
  await getCollection("proyectos", ({ data }) => data.public && data.featured)
).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  title="Augusto Rico — Economist, Data Analyst & Research"
  description="Augusto Rico is an economist and data analyst based in Bogotá, Colombia, working with Python, SQL, PySpark, Databricks, Power BI, econometrics, machine learning and applied research."
  lang="en"
  alternateEs="/"
  alternateEn="/en/"
>
  <section class="hero">
    <p class="eyebrow">{publicProfile.headline}</p>
    <h1>Economics, data and applied research.</h1>
    <p class="hero-copy">
      {publicProfile.descriptionEn}
      My work includes reproducible data pipelines, statistical analysis,
      machine learning, econometrics and research support.
    </p>

    <div class="actions">
      <a class="button primary" href="/research/">Research portfolio</a>
      <a class="button" href="/data/">Data portfolio</a>
      <a class="button" href="/finance/">Finance & Quant</a>
      <a class="text-link" href="/pdf/cv.pdf" target="_blank" rel="noreferrer">CV PDF</a>
    </div>

    <ul class="hero-facts" aria-label="Key facts">
      <li>{publicProfile.location.city}, {publicProfile.location.country}</li>
      <li>Economics · Universidad Nacional de Colombia · 2024</li>
      <li>Remote · Part-time · Freelance · Research support</li>
    </ul>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Professional profile</p>
        <h2>Data analysis and quantitative work</h2>
      </div>
    </div>

    <div class="capability-grid">
      <article class="capability">
        <span class="number">01</span>
        <h3>Data engineering & quality</h3>
        <p>
          Data extraction, cleaning, transformation, validation, deduplication and
          aggregation with Python, SQL, PySpark and Azure Databricks.
        </p>
      </article>
      <article class="capability">
        <span class="number">02</span>
        <h3>Analytics & modelling</h3>
        <p>
          Indicators, classification, clustering, time series, model evaluation
          and statistical analysis.
        </p>
      </article>
      <article class="capability">
        <span class="number">03</span>
        <h3>Research</h3>
        <p>
          Behavioral economics, game theory, causal inference, networks,
          quantitative finance, tax compliance and public policy.
        </p>
      </article>
    </div>
  </section>

  <section class="section-block">
    <div class="two-column">
      <div>
        <p class="eyebrow">Experience</p>
        <h2>Current work</h2>
        {publicProfile.experience.map((item) => (
          <div>
            <h3>{item.roleEn} · {item.organization}</h3>
            <p>{item.publicSummaryEn}</p>
          </div>
        ))}
      </div>

      <div>
        <p class="eyebrow">Technical stack</p>
        <h2>Tools and methods</h2>
        <ul class="tags">
          {[...publicProfile.skills, ...publicProfile.methods].map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected research</p>
        <h2>Working papers and projects</h2>
      </div>
    </div>

    <div class="project-grid">
      {projects.map((project) => <ProjectCard proyecto={project} />)}
    </div>
  </section>

  <section class="section-block">
    <div class="two-column">
      <div>
        <p class="eyebrow">Research areas</p>
        <ul class="tags">
          {publicProfile.researchAreas.map((area) => <li>{area}</li>)}
        </ul>
      </div>

      <div>
        <p class="eyebrow">Languages</p>
        <p>
          {publicProfile.languages.map((item) => `${item.language}: ${item.level}`).join(" · ")}
        </p>
        <p class="eyebrow">Public machine-readable profile</p>
        <ul>
          <li><a href="/api/profile.json">Profile JSON</a></li>
          <li><a href="/api/research.json">Research JSON</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/llms-full.txt">Extended LLM context</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="callout">
    <div>
      <p class="eyebrow">Projects & collaboration</p>
      <h2>Available for remote project-based work.</h2>
      <p>
        Data analysis, BI, research support, quantitative research, economic analysis,
        model evaluation and related work.
      </p>
    </div>
    <a class="button primary" href={`mailto:${publicProfile.email}?subject=Project%20/%20collaboration`}>Contact</a>
  </section>
</BaseLayout>
